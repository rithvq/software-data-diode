# Each Compose Edge node has independent EDGE_DEVICE_NN_* overrides.
EDGE_DEVICE_01_INTERVAL=2.0
EDGE_DEVICE_01_PROFILE=normal
EDGE_DEVICE_02_INTERVAL=2.5
EDGE_DEVICE_02_PROFILE=normal
EDGE_DEVICE_03_INTERVAL=1.5
EDGE_DEVICE_03_PROFILE=normal
EDGE_DEVICE_04_INTERVAL=3.0
EDGE_DEVICE_04_PROFILE=normal
EDGE_DEVICE_05_INTERVAL=2.0
EDGE_DEVICE_05_PROFILE=normal
DEVICE_HEALTH_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=5
FORWARD_TIMEOUT_SECONDS=5
EDGE_PRIVATE_KEY_PATH=/run/secrets/edge_private_key.pem
FOG_PUBLIC_KEY_PATH=/run/secrets/edge_public_key.pem
EDGE_INPUT_FRESHNESS_SECONDS=300
FOG_FRESHNESS_WINDOW_SECONDS=300
DUPLICATE_TTL_SECONDS=600
MAX_MESSAGES_PER_SECOND=25
BURST_LIMIT=50
MAX_PAYLOAD_BYTES=8192
MAX_QUEUE_SIZE=250
SCHEDULER_MODE=adaptive
# The research policy runs before signing; its transport uses FIFO.
INFORMATION_POLICY_ENABLED=true
EGRESS_MESSAGES_PER_SECOND=25
EGRESS_BURST_LIMIT=25
SCHEDULER_WEIGHT_PRIORITY=10
SCHEDULER_WEIGHT_WAITING_AGE=1
SCHEDULER_WEIGHT_URGENCY=8
SCHEDULER_WEIGHT_CONGESTION=1
SCHEDULER_WEIGHT_STARVATION=12
SCHEDULER_WEIGHT_TRANSMISSION_COST=0.01
AGING_SECONDS_PER_PRIORITY=30
STARVATION_AFTER_SECONDS=10
MAX_STARVATION_FACTOR=4
TRAFFIC_PROFILE=normal
LOW_TRAFFIC_PERCENT=70
MEDIUM_TRAFFIC_PERCENT=20
HIGH_TRAFFIC_PERCENT=8
CRITICAL_TRAFFIC_PERCENT=2
BURST_SIZE=10
BURST_INTERVAL_SECONDS=10
OVERLOAD_INTERVAL_SECONDS=0.05
CRITICAL_BURST_SIZE=5
CRITICAL_BURST_EVERY_N_MESSAGES=20
CRITICAL_EVENT_TYPES=intrusion,attack
HIGH_TEMPERATURE_THRESHOLD=38
MEDIUM_TEMPERATURE_THRESHOLD=34
MEDIUM_CPU_THRESHOLD=85
MEDIUM_MEMORY_THRESHOLD=85
MEDIUM_STATUS_VALUES=warning,abnormal,degraded
HIGH_PACKET_RATE_THRESHOLD=8000
CRITICAL_FAILED_LOGINS_THRESHOLD=5
HIGH_VIBRATION_THRESHOLD=8
FILTER_TEMPERATURE_DELTA=0.25
FILTER_HUMIDITY_DELTA=1.0
EDGE_DEDUP_TTL_SECONDS=30
LOW_SAMPLING_INTERVAL_SECONDS=5
AGGREGATION_SAMPLE_COUNT=5
ENABLE_AGGREGATION=true
EDGE_FILTER_CONGESTION_STATE=NORMAL
POSTGRES_USER=fog
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=fog_data
OBSERVABILITY_TOKEN=replace-with-a-random-internal-token
OBSERVABILITY_INTERVAL_SECONDS=5
DASHBOARD_REFRESH_SECONDS=3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-password
